// ==========================================================
// ENFES GURME / REUSABLE E-COMMERCE CORE - Prisma Schema
// Prisma 7 uyumlu — datasource url artık burada değil,
// prisma.config.ts (CLI için) ve PrismaService içindeki
// PrismaPg adapter'ında (uygulama runtime'ı için) tanımlı.
// ==========================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// Sadece kayıt anındaki YÖNTEMİ gösterir (analytics/audit amaçlı).
// Immutable — kayıt sonrası değişmez. Auth kararlarında ASLA bu alana
// bakılmaz; bunun yerine passwordHash / googleId alanlarının doluluğuna
// bakılır (bir kullanıcı LOCAL kayıt olup sonradan Google bağlayabilir).
enum SignupMethod {
  LOCAL
  GOOGLE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ==========================================================
// USER & AUTH
// ==========================================================

model User {
  id    String @id @default(uuid())
  email String @unique // UYGULAMA KATMANINDA her zaman toLowerCase().trim()
  // ile normalize edilip öyle kaydedilmeli/sorgulanmalı.
  name  String

  passwordHash String?
  googleId     String?      @unique
  signupMethod SignupMethod @default(LOCAL)

  role Role @default(CUSTOMER)
  // role alanı hiçbir DTO'da client'tan doğrudan kabul edilmemeli.
  // Rol değişikliği sadece SUPER_ADMIN'e açık ayrı bir endpoint'ten yapılmalı.

  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true) // geri döndürülebilir askıya alma
  deletedAt       DateTime? // kalıcı silme talebi (KVKK/GDPR)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Şifre değişince (sıfırlama dahil) bu andan ÖNCE verilmiş erişim
  // token'ları geçersiz sayılır — çalınan bir token 15 dk beklemeden ölür.
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  cart      Cart?
  likes     Like[]
  orders    Order[]
  reviews   Review[]

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rotation zinciri boyunca aynı kalır — token reuse detection için.
  familyId String

  issuedAt            DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime? // NULL = aktif
  replacedByTokenHash String?

  ipAddress String?
  userAgent String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// userId kasıtlı olarak relation değil — user enumeration riskini önler.
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metaData  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================================
// ADDRESS
// ==========================================================

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  fullName    String
  phone       String
  city        String
  district    String
  addressLine String
  zipCode     String?
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ==========================================================
// CATALOG
// ==========================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  // Mağazadaki sıralama (admin'de yukarı/aşağı ile değişir)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  // Soft delete. Silinince slug/name sonuna "--silindi-…" eklenir ki aynı
  // ad/adres yeni bir kategoride tekrar kullanılabilsin.
  deletedAt   DateTime?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  // Mağaza listesi: WHERE isActive AND deletedAt IS NULL ORDER BY order
  @@index([isActive, deletedAt, order])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  // Kartlarda görünen kısa açıklama
  summary     String?
  description String? @db.Text
  // "…'den başlayan fiyat": yayındaki varyantların EN DÜŞÜK fiyatı ve onun
  // eski fiyatı. Varyantlardan otomatik hesaplanır (elle yazılmaz); mağaza
  // listesinde sıralama/filtre için ürün tablosunda tutulur (performans).
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  // Not: mağaza tek para birimiyle çalışır; sepette karışık para birimi olmasın
  // diye API bu alanı dışarıdan kabul etmez.
  currency    String  @default("TRY") @db.Char(3)
  // KDV oranı (%): 0, 1, 10 veya 20. Fiyatlar KDV DAHİL girilir.
  vatRate     Int     @default(20)

  isActive  Boolean   @default(true)
  featured  Boolean   @default(false)
  // Soft delete: geçmiş siparişler ürüne bağlı kalır (OrderItem → Restrict).
  // Silinince slug/sku serbest bırakılır.
  deletedAt DateTime?

  metaTitle       String?
  metaDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Her ürünün en az bir varyantı vardır (tek seçenekli üründe admin bunu görmez)
  variants   ProductVariant[]
  images     ProductImage[]
  // Ürün detay sekmeleri (ör. enfesGurme: Hikaye, Özellikler, Nasıl Servis Edilir?)
  // Her mağaza kendi sekmelerini tanımlar; sabit kolon yok.
  tabs       ProductTab[]
  orderItems OrderItem[]
  reviews    Review[]
  likes      Like[]

  @@index([categoryId])
  // Mağaza listesi filtreleri ve sıralamaları
  @@index([isActive, deletedAt, categoryId])
  @@index([isActive, deletedAt, featured])
  @@index([createdAt])
  @@index([price])
}

// Satılan şey: fiyat, stok ve SKU varyanttadır (ör. 250 g / 500 g / 1 kg).
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Müşterinin seçtiği etiket (ör. "500 g"). Tek varyantlı üründe satış birimi.
  name           String
  sku            String?  @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  // Kapalıysa stok düşülmez/kontrol edilmez
  trackStock     Boolean  @default(true)
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  // Soft delete: geçmiş siparişler varyanta bağlı kalır
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, deletedAt, order])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url   String
  alt   String?
  order Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, order])
}

model ProductTab {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title String
  body  String @db.Text
  order Int    @default(0)

  @@index([productId, order])
}

// Yüklenen görseller (admin → medya kütüphanesi)
model Media {
  id String @id @default(uuid())

  originalName String
  storageKey   String @unique
  mimeType     String
  size         Int
  width        Int
  height       Int

  url String @unique
  // Erişilebilirlik ve SEO için <img alt>
  alt String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Review {
  id String @id @default(uuid())

  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating  Int
  comment String @db.Text

  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isApproved])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ==========================================================
// CART
// ==========================================================

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Sepete ürün değil varyant girer (500 g ve 1 kg ayrı satırlardır)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ==========================================================
// ORDER & PAYMENT
// ==========================================================

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // Örn: "ORD-2026-8921". Sıralı sayı KULLANMA
  // (rakiplerin günlük sipariş sayısını tahmin etmesini önler); yıl +
  // rastgele/nanoid parçası ile üret.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status   OrderStatus @default(PENDING)
  total    Decimal     @db.Decimal(10, 2)
  currency String      @default("TRY") @db.Char(3)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([addressId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Sipariş anı snapshot'ı — admin ürün adını sonradan değiştirse bile
  // geçmiş siparişte müşterinin gördüğü isim/SKU bozulmaz.
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  productName String
  variantName String
  productSku  String?
  // Sipariş anındaki KDV oranı (fatura için)
  vatRate     Int

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status   PaymentStatus @default(PENDING)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("TRY") @db.Char(3)

  provider            String // "iyzico", "paytr", "stripe" vs.
  providerPaymentId   String? @unique // idempotency kontrolü için kritik
  providerRawResponse Json?

  errorMessage String?
  paidAt       DateTime?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([providerPaymentId])
}

// ==========================================================
// SİTE TEMASI / CMS
// ==========================================================

model SiteTheme {
  id Int @id @default(1)

  siteName String @default("Enfes Gurme")

  primaryColor    String @default("#8B5E3C")
  secondaryColor  String @default("#EFE3CC")
  backgroundColor String @default("#F6EFDD")
  textColor       String @default("#1A1A1A")

  backgroundImageUrl String?
  backgroundImageFit String  @default("cover")

  cardTextureUrl String?

  fontHeading String @default("Playfair Display")
  fontBody    String @default("Inter")

  logoUrl    String @default("/logo.png")
  faviconUrl String @default("/favicon.ico")

  updatedAt DateTime @updatedAt
}

model ContentBlock {
  id String @id @default(uuid())

  page String
  key  String

  data Json

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page, isActive])
}

model FaqItem {
  id       String  @id @default(uuid())
  category String?
  question String
  answer   String  @db.Text
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}
