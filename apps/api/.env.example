# Kopyala: cp .env.example .env  — .env ASLA commit edilmez.
# Gizli değer üretmek için: openssl rand -base64 64

NODE_ENV=development
PORT=4000

# Yerel geliştirme: kökteki infrastructure/compose.yaml ile açılan PostgreSQL
DATABASE_URL=postgresql://commerce:commerce_dev_password@localhost:5434/core_commerce?schema=public
DB_POOL_MAX=10

# Erişim token'ını (JWT) imzalar — en az 64 karakter: openssl rand -base64 64
JWT_ACCESS_SECRET=
# Erişim token'ı kısa, oturum (refresh) uzun ömürlü. Biçim: 15m, 12h, 7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Şifre özeti maliyeti (argon2id). Daha düşük değer kabul edilmez (OWASP alt sınırı).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Art arda bu kadar hatalı şifreden sonra hesap şu kadar dakika kilitlenir
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# E-postadaki bağlantıların açılacağı mağaza adresi
# (mağaza şu sayfaları sağlamalı: /eposta-dogrula, /sifre-sifirla, /sifremi-unuttum)
STOREFRONT_URL=http://localhost:3000
# Yöneticilerin şifre sıfırlama bağlantıları buraya gider
ADMIN_URL=http://localhost:3001

# Mağazadaki ürün sayfası yolu ({slug} zorunlu): e-posta bağlantıları ve Google ürün akışı
STOREFRONT_PRODUCT_PATH=/urun/{slug}

# Raporlarda gün sınırı bu saat dilimine göre (IANA adı)
STORE_TIMEZONE=Europe/Istanbul

# İki adımlı doğrulama (yöneticiler). Gizli anahtarları şifreleyen anahtar; production'da zorunlu.
# Üretmek için: openssl rand -base64 32   (kaybetmeyin: değişirse herkes 2FA'yı yeniden kurar)
TWO_FACTOR_ENCRYPTION_KEY=
# Yöneticiler 2FA kurmadan panele giremesin. Boş: production'da açık, geliştirmede kapalı.
ADMIN_2FA_REQUIRED=

# Yeni sipariş bildirimi bu adrese gider (boşsa mağaza ayarlarındaki satıcı e-postası)
ORDER_NOTIFY_EMAIL=

# iyzico ödeme (iyzico panelinden: Ayarlar → Firma Ayarları). Boş bırakılırsa online ödeme kapalıdır.
# Önce sandbox anahtarlarıyla deneyin (https://sandbox-merchant.iyzipay.com). Canlıya geçince:
# IYZICO_BASE_URL=https://api.iyzipay.com  (anahtarları da canlı anahtarlarla değiştirin)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# API'nin dışarıdan erişilen adresi: iyzico ödeme sonucunu buraya döndürür (/payments/iyzico/callback).
# Production'da https zorunlu. Mağaza sonuç sayfası: STOREFRONT_URL/siparis/sonuc
API_PUBLIC_URL=http://localhost:4000

# E-posta (SMTP). Geliştirmede boş bırakılırsa e-postalar API konsoluna yazılır.
# Production'da zorunlu.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Görseller: local (sunucu diski, apps/api/storage/media) veya cloudinary (önerilen)
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=core-commerce

# Google ile giriş (isteğe bağlı): Google Cloud Console → OAuth 2.0 istemci kimliği
GOOGLE_CLIENT_ID=

# İlk süper yönetici (yalnızca `pnpm --filter api create-admin` kullanır; sonra silin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Tarayıcıdan API'ye doğrudan istek atabilecek adresler (virgülle): mağaza, admin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API önündeki güvenilir reverse proxy sayısı (Caddy/Nginx varsa 1)
TRUST_PROXY_HOPS=0

# Mağaza/admin sunucusu ile ortak anahtar, en az 32 karakter (production'da zorunlu)
WEB_API_SECRET=
