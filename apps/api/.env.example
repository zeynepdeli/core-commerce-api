# Kopyala: cp .env.example .env  — .env ASLA commit edilmez.
# Gizli değer üretmek için: openssl rand -base64 64

NODE_ENV=development
PORT=4000

# Yerel geliştirme: kökteki infrastructure/compose.yaml ile açılan PostgreSQL
DATABASE_URL=postgresql://commerce:commerce_dev_password@localhost:5434/core_commerce?schema=public
DB_POOL_MAX=10

# Erişim token'ını (JWT) imzalar — en az 64 karakter: openssl rand -base64 64
JWT_ACCESS_SECRET=
# Erişim token'ı kısa, oturum (refresh) uzun ömürlü. Biçim: 15m, 12h, 7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Şifre özeti maliyeti (argon2id). Daha düşük değer kabul edilmez (OWASP alt sınırı).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Art arda bu kadar hatalı şifreden sonra hesap şu kadar dakika kilitlenir
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# E-postadaki bağlantıların açılacağı mağaza adresi
# (mağaza şu sayfaları sağlamalı: /eposta-dogrula, /sifre-sifirla, /sifremi-unuttum)
STOREFRONT_URL=http://localhost:3000

# E-posta (SMTP). Geliştirmede boş bırakılırsa e-postalar API konsoluna yazılır.
# Production'da zorunlu.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google ile giriş (isteğe bağlı): Google Cloud Console → OAuth 2.0 istemci kimliği
GOOGLE_CLIENT_ID=

# İlk süper yönetici (yalnızca `pnpm --filter api create-admin` kullanır; sonra silin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Tarayıcıdan API'ye doğrudan istek atabilecek adresler (virgülle): mağaza, admin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API önündeki güvenilir reverse proxy sayısı (Caddy/Nginx varsa 1)
TRUST_PROXY_HOPS=0

# Mağaza/admin sunucusu ile ortak anahtar, en az 32 karakter (production'da zorunlu)
WEB_API_SECRET=
