// ==========================================================
// ENFES GURME / REUSABLE E-COMMERCE CORE - Prisma Schema
// Prisma 7 uyumlu — datasource url artık burada değil,
// prisma.config.ts (CLI için) ve PrismaService içindeki
// PrismaPg adapter'ında (uygulama runtime'ı için) tanımlı.
// ==========================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// Sadece kayıt anındaki YÖNTEMİ gösterir (analytics/audit amaçlı).
// Immutable — kayıt sonrası değişmez. Auth kararlarında ASLA bu alana
// bakılmaz; bunun yerine passwordHash / googleId alanlarının doluluğuna
// bakılır (bir kullanıcı LOCAL kayıt olup sonradan Google bağlayabilir).
enum SignupMethod {
  LOCAL
  GOOGLE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ==========================================================
// USER & AUTH
// ==========================================================

model User {
  id    String @id @default(uuid())
  email String @unique // UYGULAMA KATMANINDA her zaman toLowerCase().trim()
  // ile normalize edilip öyle kaydedilmeli/sorgulanmalı.
  name  String

  passwordHash String?
  googleId     String?      @unique
  signupMethod SignupMethod @default(LOCAL)

  role Role @default(CUSTOMER)
  // role alanı hiçbir DTO'da client'tan doğrudan kabul edilmemeli.
  // Rol değişikliği sadece SUPER_ADMIN'e açık ayrı bir endpoint'ten yapılmalı.

  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true) // geri döndürülebilir askıya alma
  deletedAt       DateTime? // kalıcı silme talebi (KVKK/GDPR)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  cart      Cart?
  likes     Like[]
  orders    Order[]
  reviews   Review[]

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rotation zinciri boyunca aynı kalır — token reuse detection için.
  familyId String

  issuedAt            DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime? // NULL = aktif
  replacedByTokenHash String?

  ipAddress String?
  userAgent String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// userId kasıtlı olarak relation değil — user enumeration riskini önler.
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metaData  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================================
// ADDRESS
// ==========================================================

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  fullName    String
  phone       String
  city        String
  district    String
  addressLine String
  zipCode     String?
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ==========================================================
// CATALOG
// ==========================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@index([deletedAt])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String  @db.Text
  price       Decimal @db.Decimal(10, 2)
  currency    String  @default("TRY") @db.Char(3)
  stock       Int     @default(0)
  sku         String? @unique
  // Not: gerçek varyant yönetimi gerekirse (500gr/1kg vs.) SKU/stok/fiyat
  // ayrı bir ProductVariant modeline taşınmalı.

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  story             String? @db.Text
  features          String? @db.Text
  servingSuggestion String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  likes      Like[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isActive, categoryId])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url   String
  alt   String?
  order Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Review {
  id String @id @default(uuid())

  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating  Int
  comment String @db.Text

  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isApproved])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ==========================================================
// CART
// ==========================================================

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

// ==========================================================
// ORDER & PAYMENT
// ==========================================================

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // Örn: "ORD-2026-8921". Sıralı sayı KULLANMA
  // (rakiplerin günlük sipariş sayısını tahmin etmesini önler); yıl +
  // rastgele/nanoid parçası ile üret.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status   OrderStatus @default(PENDING)
  total    Decimal     @db.Decimal(10, 2)
  currency String      @default("TRY") @db.Char(3)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([addressId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Sipariş anı snapshot'ı — admin ürün adını sonradan değiştirse bile
  // geçmiş siparişte müşterinin gördüğü isim/SKU bozulmaz.
  productName String
  productSku  String?

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status   PaymentStatus @default(PENDING)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("TRY") @db.Char(3)

  provider            String // "iyzico", "paytr", "stripe" vs.
  providerPaymentId   String? @unique // idempotency kontrolü için kritik
  providerRawResponse Json?

  errorMessage String?
  paidAt       DateTime?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([providerPaymentId])
}

// ==========================================================
// SİTE TEMASI / CMS
// ==========================================================

model SiteTheme {
  id Int @id @default(1)

  siteName String @default("Enfes Gurme")

  primaryColor    String @default("#8B5E3C")
  secondaryColor  String @default("#EFE3CC")
  backgroundColor String @default("#F6EFDD")
  textColor       String @default("#1A1A1A")

  backgroundImageUrl String?
  backgroundImageFit String  @default("cover")

  cardTextureUrl String?

  fontHeading String @default("Playfair Display")
  fontBody    String @default("Inter")

  logoUrl    String @default("/logo.png")
  faviconUrl String @default("/favicon.ico")

  updatedAt DateTime @updatedAt
}

model ContentBlock {
  id String @id @default(uuid())

  page String
  key  String

  data Json

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page, isActive])
}

model FaqItem {
  id       String  @id @default(uuid())
  category String?
  question String
  answer   String  @db.Text
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}
