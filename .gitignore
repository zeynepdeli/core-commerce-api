# Bağımlılıklar — herkes kendi bilgisayarında `pnpm install` ile üretir
node_modules/

# Derlenmiş çıktı — kaynak koddan her zaman yeniden üretilebilir
dist/
.next/
*.tsbuildinfo

# HASSAS: gerçek secret'lar, DB şifresi burada. Asla commit edilmemeli.
.env
.env.*
!.env.example
!.env.*.example

# Prisma'nın otomatik ürettiği TypeScript client kodu
**/src/generated/

# Yüklenen medya (yerel depolama)
apps/api/storage/media/*
!apps/api/storage/media/.gitkeep

# Test çıktıları
coverage/
test-results/

# Editör/OS'a özel dosyalar
.DS_Store
.vscode/*
!.vscode/extensions.json

# Log dosyaları
*.log
npm-debug.log*
pnpm-debug.log*
.history/
